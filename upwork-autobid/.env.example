# =============================================================================
# UpBid - environment configuration
# Copy to .env and fill in. Only DATABASE_URL is required to boot in dev;
# ANTHROPIC_API_KEY is required for proposal drafting, and API_KEY is required
# whenever NODE_ENV=production.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Datastores (REQUIRED: DATABASE_URL) -------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upbid?schema=public
REDIS_URL=redis://localhost:6379

# --- API / dashboard auth ----------------------------------------------------
# Shared secret for the dashboard and the HTTP API (sent as X-API-Key or
# Authorization: Bearer). REQUIRED in production, min 16 chars.
API_KEY=
# Externally reachable base URL. Used for one-tap approval links in
# notifications and for the Upwork OAuth callback.
PUBLIC_BASE_URL=http://localhost:3000

# --- Anthropic (proposal drafting + optional LLM re-rank) --------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=2000

# --- Upwork API --------------------------------------------------------------
# OAuth2 app credentials from https://www.upwork.com/developer/keys/
# Without these the upwork_api source is skipped and only rss/imap can run.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:3000/oauth/upwork/callback
# Organization/tenant id required by some GraphQL queries.
UPWORK_TENANT_ID=
UPWORK_API_BASE=https://api.upwork.com
UPWORK_GRAPHQL_URL=https://api.upwork.com/graphql

# --- Job sources -------------------------------------------------------------
# Comma-separated. Available: upwork_api, rss, imap
SOURCES=upwork_api
# Comma-separated Upwork saved-search RSS feed URLs (used when SOURCES has rss).
RSS_FEED_URLS=

# --- IMAP source (parses Upwork job-alert emails) ----------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SEARCH_FROM=no-reply@upwork.com

# --- Polling cadence ---------------------------------------------------------
# Normal repeatable poll interval, in seconds.
POLL_INTERVAL_SECONDS=60
# Tighter interval for profiles flagged as high priority.
FAST_POLL_INTERVAL_SECONDS=20
MAX_JOBS_PER_POLL=100

# --- Submission routing ------------------------------------------------------
# Detection, scoring and drafting are always on. These control the last step only.
#
# AUTO_SUBMIT=false  -> every proposal lands in the human approval queue.
# AUTO_SUBMIT=true   -> proposals above the profile's autoBidThreshold may be
#                       submitted without a tap, but ONLY if the selected
#                       SUBMITTER is configured and reports canAutoSubmit.
#                       Otherwise the dispatcher fails closed into the queue.
AUTO_SUBMIT=false
# DRY_RUN=true records what would have been submitted without calling anything.
# Leave true until you have watched the drafts for a while.
DRY_RUN=true
# review_queue (default, human taps approve) | api (partner-scoped Upwork API)
# | webhook (hand off to your own endpoint)
SUBMITTER=review_queue
# Required when SUBMITTER=webhook. Receives the proposal payload.
SUBMIT_WEBHOOK_URL=
# Optional shared secret; payloads are signed HMAC-SHA256 in X-UpBid-Signature.
SUBMIT_WEBHOOK_SECRET=

# --- Notifications (at least one channel strongly recommended) ---------------
# Telegram gives the one-tap Approve button. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack incoming webhook URL.
SLACK_WEBHOOK_URL=
# Email fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# --- Tuning ------------------------------------------------------------------
# Concurrent BullMQ jobs per worker process.
WORKER_CONCURRENCY=5
HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=3
METRICS_ENABLED=true
