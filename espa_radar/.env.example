# ============================================================
# ESPA Radar — παράδειγμα ρυθμίσεων
# Αντέγραψέ το ως .env στη ρίζα του project και συμπλήρωσε.
# ============================================================

# --- Βάση δεδομένων ---
# Χωρίς ρύθμιση χρησιμοποιείται SQLite στο ./data/espa_radar.db
# Για production βάλε Postgres:
# ESPA_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/espa_radar

# --- Συχνότητα λειτουργίας ---
ESPA_SCAN_INTERVAL_MINUTES=180     # σάρωση πηγών κάθε 3 ώρες
ESPA_DIGEST_HOUR=8                 # ώρα ημερήσιας σύνοψης
ESPA_DIGEST_MINUTE=30
ESPA_DEADLINE_REMINDER_DAYS=14,7,3,1
ESPA_TIMEZONE=Europe/Athens
ESPA_SCAN_ON_STARTUP=true
ESPA_SCHEDULER_ENABLED=true

# --- Κατώφλια ---
ESPA_MIN_SCORE=45                  # κάτω από αυτό δεν δημιουργείται ταίριασμα
ESPA_INSTANT_MIN_SCORE=70          # πάνω από αυτό στέλνεται άμεση ειδοποίηση

# --- Κανάλια ειδοποίησης (console,email,telegram,webhook) ---
ESPA_NOTIFY_CHANNELS=console

# Email (SMTP)
# ESPA_SMTP_HOST=smtp.gmail.com
# ESPA_SMTP_PORT=587
# ESPA_SMTP_USER=you@gmail.com
# ESPA_SMTP_PASSWORD=app-password-16-χαρακτήρων
# ESPA_SMTP_FROM=you@gmail.com
# ESPA_SMTP_STARTTLS=true

# Telegram (φτιάξε bot με το @BotFather, πάρε chat id από το @userinfobot)
# ESPA_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# ESPA_TELEGRAM_CHAT_ID=123456789

# Webhook (Slack incoming webhook, Make, n8n, δικό σου endpoint)
# ESPA_WEBHOOK_URL=https://hooks.slack.com/services/...
# ESPA_WEBHOOK_SECRET=κάτι-μυστικό   # υπογράφει το payload με HMAC-SHA256

# --- Δίκτυο & ευγένεια προς τις πηγές ---
ESPA_HTTP_TIMEOUT=30
ESPA_HTTP_RETRIES=3
ESPA_HTTP_CONCURRENCY=4
ESPA_POLITENESS_DELAY=1.0          # δευτερόλεπτα ανάμεσα σε αιτήματα στον ίδιο host

# --- API ---
# ESPA_API_KEY=βάλε-κλειδί-για-να-κλειδώσεις-τα-endpoints-εγγραφής
# ESPA_PUBLIC_BASE_URL=https://espa-radar.example.com
