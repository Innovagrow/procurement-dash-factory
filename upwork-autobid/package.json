{
  "name": "upwork-autobid",
  "version": "1.0.0",
  "private": true,
  "description": "UpBid - continuous Upwork job detection, scoring, proposal drafting and approval-gated submission.",
  "license": "UNLICENSED",
  "main": "dist/server/index.js",
  "scripts": {
    "dev:api": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/workers/index.js",
    "start:all": "node dist/bootstrap/all-in-one.js",
    "worker": "tsx src/workers/index.ts",
    "api": "tsx src/server/index.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.18.0",
    "axios": "^1.7.4",
    "bullmq": "^5.12.0",
    "cron-parser": "^4.9.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "imapflow": "^1.0.0",
    "ioredis": "^5.4.1",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.14",
    "p-limit": "^3.1.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
